---
const interests = [
  {
    title: 'Powerlifting',
    tag: 'Routine & Discipline',
    description:
      'Training with a long-term goal and routine, logging progress, and chasing numbers. The same habits (measuring carefully, accepting that progress is slow, not skipping the fundamentals) tend to follow me into engineering work too.',
  },
  {
    title: 'Poker & Chess',
    tag: 'Strategy & Probability',
    description:
      'Two games about information, probability, and knowing when to be patient. These two really test my ability to think many steps ahead, whilst keeping self-accountable when things go wrong. Respect to the high-rollers and grandmasters.',
  },
  {
    title: 'Music',
    tag: 'Focus & Flow',
    description:
      "My playlist goes from masterful OSTs, to jazz, to heavy rock, and everything in between depending on the mood and the task. The range is probably wider than it should be, but I'll defend all of it.",
  },
];
---

<section id='interests' class='py-12 sm:py-16 scroll-mt-16'>
  <div class='space-y-6'>
    <div class='space-y-1'>
      <h2
        class='text-2xl sm:text-3xl font-bold text-(--color-text-primary)'
        style='font-family: var(--font-heading);'
      >
        Interests & Pursuits
      </h2>
      <p class='text-sm text-(--color-text-secondary)'>
        What occupies my time when I step away from the keyboard.
      </p>
    </div>

    <!-- Unified narrative layout avoiding the generic 3-box icon card trope -->
    <div
      class='divide-y divide-(--color-border) rounded-lg border border-(--color-border) bg-(--color-bg-surface) overflow-hidden shadow-xs'
    >
      {
        interests.map((item) => (
          <div class='p-6 flex flex-col md:flex-row md:items-start justify-between gap-4 sm:gap-6 hover:bg-(--color-bg-muted)/30 transition-colors'>
            <div class='md:w-1/3 shrink-0 space-y-1.5'>
              <span class='inline-block text-[11px] font-mono font-medium text-(--color-accent) uppercase tracking-wider'>
                {item.tag}
              </span>
              <h3
                class='text-base sm:text-lg font-semibold text-(--color-text-primary)'
                style='font-family: var(--font-heading);'
              >
                {item.title}
              </h3>
            </div>
            <div class='md:w-2/3'>
              <p class='text-sm text-(--color-text-secondary) leading-relaxed'>
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
