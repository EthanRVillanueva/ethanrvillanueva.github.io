---
---
<section id="hero" class="min-h-[75vh] flex flex-col justify-center pt-16 pb-12">
  <div class="flex flex-col-reverse md:flex-row items-center md:items-start justify-between gap-8 md:gap-12">
    <!-- Left Column: Copy & Actions -->
    <div class="space-y-6 flex-1 text-left">
      <div class="space-y-2">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-(--color-text-primary)"
          style="font-family: var(--font-heading);"
        >
          Ethan Villanueva
        </h1>
        <p class="text-lg sm:text-xl font-medium text-(--color-accent)">
          Software Engineer · University of Nottingham
        </p>
      </div>

      <p class="text-base sm:text-lg text-(--color-text-secondary) max-w-2xl leading-relaxed">
        Final-year Computer Science student at Nottingham, back from a 13-month software engineering placement at Siemens. I enjoy digging into large codebases, backend systems, and building software that actually has to work in the real world.
      </p>

      <!-- Quick Actions -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <!-- Primary Action -->
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-md bg-(--color-accent) text-white hover:bg-(--color-accent-hover) transition-all shadow-xs cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Get In Touch
        </a>

        <!-- Secondary: CV -->
        <a
          href="/ethanvillanueva-cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          download
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-(--color-border) bg-(--color-bg-surface) text-(--color-text-primary) hover:border-(--color-accent) hover:text-(--color-accent) transition-all shadow-xs"
        >
          <svg class="w-4 h-4 text-(--color-text-secondary)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CV
        </a>

        <!-- Social Outlines: GitHub & LinkedIn (explicit text-(--color-text-primary) for dark mode contrast) -->
        <a
          href="https://github.com/EthanRVillanueva"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ethan Villanueva on GitHub"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-(--color-border) bg-(--color-bg-surface) text-(--color-text-primary) hover:border-(--color-accent) hover:text-(--color-accent) transition-all shadow-xs"
        >
          <svg class="w-4 h-4 text-current" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/ethanrvillanueva"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ethan Villanueva on LinkedIn"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-(--color-border) bg-(--color-bg-surface) text-(--color-text-primary) hover:border-(--color-accent) hover:text-(--color-accent) transition-all shadow-xs"
        >
          <svg class="w-4 h-4 text-current" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.46 1.46 0 1 0 0-2.92 1.46 1.46 0 0 0 0 2.92M7.86 18.5V10.13H5.07V18.5h2.79z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Right Column: Profile Picture / Headshot Placeholder -->
    <div class="shrink-0 flex justify-center">
      <div class="relative group">
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-(--color-accent) to-emerald-300 opacity-20 group-hover:opacity-40 blur-sm transition-opacity duration-300"></div>
        <div class="relative w-65 h-65 sm:w-73 sm:h-73 rounded-2xl overflow-hidden border-2 border-(--color-border) bg-(--color-bg-surface) shadow-md flex items-center justify-center p-2">
          <img
            src="/pfp_square.jpg"
            alt="Ethan Villanueva"
            width="200"
            height="200"
            class="w-full h-full object-cover rounded-xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Downward Scroll Indicator -->
  <div class="pt-16 flex justify-start">
    <a href="#about" aria-label="Scroll to About section" class="text-(--color-text-secondary) hover:text-(--color-accent) transition-colors">
      <svg class="w-6 h-6 animate-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
