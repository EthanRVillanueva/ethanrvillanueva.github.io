---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<div
  class='inline-block hover:rotate-6 hover:scale-110 transition-transform duration-200 cursor-default select-none'
  title='Badtz-Maru says hi!'
  aria-hidden='true'
  data-badtz-maru
>
  <img
    src='/badtzmaru.png'
    alt='Badtz-Maru'
    width={size}
    height={size}
    class='badtz-maru-pixel drop-shadow-xs'
    style={`width: ${size}px; height: ${size}px; image-rendering: pixelated;`}
    loading='eager'
  />
</div>

<style>
  .badtz-maru-pixel {
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }
</style>
