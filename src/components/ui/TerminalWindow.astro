---
interface Props {
  title?: string;
}

const { title = 'ethan@portfolio: ~' } = Astro.props;
---

<div
  class='terminal-window relative rounded-lg overflow-hidden shadow-xl border border-[#333344] bg-[#181824] text-gray-200 select-none transition-all duration-300'
  data-draggable-terminal
>
  <!-- Terminal Header / Title Bar -->
  <div
    class='terminal-titlebar flex items-center justify-between px-4 py-2.5 bg-[#252536] border-b border-[#333344] cursor-grab active:cursor-grabbing select-none'
    data-drag-handle
  >
    <!-- macOS Dot Controls -->
    <div
      class='terminal-controls flex items-center gap-2'
      data-terminal-controls
    >
      <button
        type='button'
        class='terminal-dot w-3 h-3 rounded-full bg-[#FF5F56] inline-flex items-center justify-center p-0 border-0 outline-none group cursor-pointer'
        aria-label='Close terminal and reboot shell'
        title='Reboot shell'
        data-dot-close
      >
        <span
          class='text-[9px] font-bold text-[#4c0000] opacity-0 group-hover:opacity-100 leading-none select-none transition-opacity'
          aria-hidden='true'>✕</span
        >
      </button>
      <button
        type='button'
        class='terminal-dot w-3 h-3 rounded-full bg-[#FFBD2E] inline-flex items-center justify-center p-0 border-0 outline-none group cursor-pointer'
        aria-label='Minimize terminal'
        title='Minimize'
        data-dot-minimize
      >
        <span
          class='text-[9px] font-bold text-[#5c3e00] opacity-0 group-hover:opacity-100 leading-none select-none transition-opacity'
          aria-hidden='true'>−</span
        >
      </button>
      <button
        type='button'
        class='terminal-dot w-3 h-3 rounded-full bg-[#27C93F] inline-flex items-center justify-center p-0 border-0 outline-none group cursor-pointer'
        aria-label='Maximize terminal'
        title='Maximize'
        data-dot-maximize
      >
        <span
          class='text-[9px] font-bold text-[#00470a] opacity-0 group-hover:opacity-100 leading-none select-none transition-opacity'
          aria-hidden='true'>+</span
        >
      </button>
    </div>

    <div
      class='text-xs font-mono text-gray-400 select-none flex items-center gap-2'
    >
      <span class='text-gray-400 hidden sm:inline' aria-hidden='true'
        >bash —</span
      >
      <span>{title}</span>
    </div>
    <div
      class='w-12 text-right text-[11px] text-gray-400 font-mono hidden sm:block'
      aria-hidden='true'
    >
      80×24
    </div>
  </div>

  <!-- Terminal Reboot Overlay -->
  <div
    class='terminal-reboot-overlay hidden absolute inset-0 bg-[#181824]/95 z-30 flex flex-col justify-center items-center p-6 text-center font-mono text-xs space-y-2 backdrop-blur-xs'
    data-reboot-overlay
  >
    <div class='text-[#FF5F56] font-bold'>
      [Process terminated — shell exited with status 0]
    </div>
    <div class='text-[#27C93F] animate-pulse'>
      Spawning new interactive zsh / bash session...
    </div>
    <div class='text-gray-400 text-[11px]'>
      Restoring environment variables & working directory...
    </div>
  </div>

  <!-- Terminal Body -->
  <div
    class='terminal-body p-4 sm:p-6 font-mono text-sm overflow-x-auto leading-relaxed select-text transition-all duration-200'
    style='font-family: var(--font-mono);'
    data-terminal-body
  >
    <slot />
  </div>
</div>

<style>
  .terminal-window {
    will-change: transform;
    touch-action: pan-y;
  }

  .terminal-titlebar {
    touch-action: none;
  }

  .terminal-dot {
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }

  .terminal-dot:hover {
    filter: brightness(1.15);
    transform: scale(1.12);
  }

  /* Minimized state */
  .terminal-window.is-minimized .terminal-body {
    display: none !important;
  }

  .terminal-window.is-minimized .terminal-titlebar {
    cursor: pointer;
  }

  /* Maximized state */
  .terminal-window.is-maximized {
    max-width: 100% !important;
    width: 100% !important;
  }

  .terminal-window.is-maximized .terminal-body {
    min-height: 480px;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-draggable-terminal]')
    .forEach((wrapper) => {
      const handle = wrapper.querySelector<HTMLElement>('[data-drag-handle]');
      const body = wrapper.querySelector<HTMLElement>('[data-terminal-body]');
      const rebootOverlay = wrapper.querySelector<HTMLElement>(
        '[data-reboot-overlay]',
      );
      const btnClose =
        wrapper.querySelector<HTMLButtonElement>('[data-dot-close]');
      const btnMin = wrapper.querySelector<HTMLButtonElement>(
        '[data-dot-minimize]',
      );
      const btnMax = wrapper.querySelector<HTMLButtonElement>(
        '[data-dot-maximize]',
      );

      let isMinimized = false;
      let isMaximized = false;
      let isRebooting = false;

      // Reboot sequence (Red Dot)
      function rebootTerminal() {
        if (isRebooting) return;
        isRebooting = true;

        // Flash terminal briefly
        wrapper.style.opacity = '0.4';
        setTimeout(() => {
          wrapper.style.opacity = '1';
          rebootOverlay?.classList.remove('hidden');
        }, 100);

        setTimeout(() => {
          rebootOverlay?.classList.add('hidden');
          wrapper.style.transition =
            'transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
          wrapper.style.transform = 'scale(1.01)';
          setTimeout(() => {
            wrapper.style.transform = 'scale(1)';
            isRebooting = false;
            setTimeout(() => {
              wrapper.style.transition = '';
            }, 300);
          }, 150);
        }, 1200);
      }

      btnClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        rebootTerminal();
      });

      // Minimize toggle (Yellow Dot)
      function toggleMinimize() {
        isMinimized = !isMinimized;
        if (isMinimized) {
          wrapper.classList.add('is-minimized');
        } else {
          wrapper.classList.remove('is-minimized');
        }
      }

      btnMin?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMinimize();
      });

      // Restore when clicking title bar in minimized mode
      handle?.addEventListener('click', (e) => {
        if (
          isMinimized &&
          !(e.target as HTMLElement).closest('.terminal-controls')
        ) {
          toggleMinimize();
        }
      });

      // Maximize toggle (Green Dot)
      function toggleMaximize() {
        isMaximized = !isMaximized;
        if (isMaximized) {
          wrapper.classList.add('is-maximized');
          btnMax?.setAttribute('title', 'Restore');
          btnMax?.setAttribute('aria-label', 'Restore terminal size');
        } else {
          wrapper.classList.remove('is-maximized');
          btnMax?.setAttribute('title', 'Maximize');
          btnMax?.setAttribute('aria-label', 'Maximize terminal');
        }
      }

      btnMax?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMaximize();
      });

      // Spring drag micro-interaction: drag anywhere on title bar, snaps smoothly back into place on release
      if (!handle) return;

      let isDragging = false;
      let startX = 0;
      let startY = 0;

      handle.addEventListener('pointerdown', (e: PointerEvent) => {
        if ((e.target as HTMLElement).closest('.terminal-controls')) return;
        if (e.button !== 0) return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        wrapper.style.transition = 'none';
        wrapper.style.zIndex = '30';
        handle.setPointerCapture(e.pointerId);
      });

      handle.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        const rot = Math.max(-5, Math.min(5, dx * 0.03));
        wrapper.style.transform = `translate3d(${dx}px, ${dy}px, 0) rotate(${rot}deg)`;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        try {
          handle.releasePointerCapture(e.pointerId);
        } catch {
          // Pointer already released
        }
        wrapper.style.transition =
          'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        wrapper.style.transform = 'translate3d(0px, 0px, 0px) rotate(0deg)';

        setTimeout(() => {
          wrapper.style.transition = '';
          wrapper.style.zIndex = '';
        }, 500);
      };

      handle.addEventListener('pointerup', endDrag);
      handle.addEventListener('pointercancel', endDrag);
    });
</script>
