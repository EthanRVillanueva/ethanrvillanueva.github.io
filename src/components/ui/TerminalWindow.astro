---
interface Props {
  title?: string;
}

const { title = 'ethan@portfolio: ~' } = Astro.props;
---

<div
  class="terminal-window rounded-lg overflow-hidden shadow-xl border border-[#333344] bg-[#181824] text-gray-200 select-none"
  data-draggable-terminal
>
  <!-- Terminal Header / Title Bar -->
  <div
    class="terminal-titlebar flex items-center justify-between px-4 py-2.5 bg-[#252536] border-b border-[#333344] cursor-grab active:cursor-grabbing select-none"
    data-drag-handle
  >
    <div class="flex items-center gap-2" aria-hidden="true">
      <span class="terminal-dot w-3 h-3 rounded-full bg-[#FF5F56] inline-block"></span>
      <span class="terminal-dot w-3 h-3 rounded-full bg-[#FFBD2E] inline-block"></span>
      <span class="terminal-dot w-3 h-3 rounded-full bg-[#27C93F] inline-block"></span>
    </div>
    <div class="text-xs font-mono text-gray-400 select-none">
      {title}
    </div>
    <div class="w-12" aria-hidden="true"></div>
  </div>

  <!-- Terminal Body -->
  <div class="terminal-body p-4 sm:p-6 font-mono text-sm overflow-x-auto leading-relaxed select-text" style="font-family: var(--font-mono);">
    <slot />
  </div>
</div>

<style>
  .terminal-window {
    will-change: transform;
    touch-action: pan-y;
  }

  .terminal-titlebar {
    touch-action: none;
  }
</style>

<script>
  // Spring drag micro-interaction: drag anywhere, snaps smoothly back into place on release
  document.querySelectorAll<HTMLElement>('[data-draggable-terminal]').forEach((wrapper) => {
    const handle = wrapper.querySelector<HTMLElement>('[data-drag-handle]');
    if (!handle) return;

    let isDragging = false;
    let startX = 0;
    let startY = 0;

    handle.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.button !== 0) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      wrapper.style.transition = 'none';
      wrapper.style.zIndex = '30';
      handle.setPointerCapture(e.pointerId);
    });

    handle.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      const rot = Math.max(-5, Math.min(5, dx * 0.03));
      wrapper.style.transform = `translate3d(${dx}px, ${dy}px, 0) rotate(${rot}deg)`;
    });

    const endDrag = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      try {
        handle.releasePointerCapture(e.pointerId);
      } catch {
        // Pointer already released
      }
      wrapper.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
      wrapper.style.transform = 'translate3d(0px, 0px, 0px) rotate(0deg)';

      setTimeout(() => {
        wrapper.style.transition = '';
        wrapper.style.zIndex = '';
      }, 500);
    };

    handle.addEventListener('pointerup', endDrag);
    handle.addEventListener('pointercancel', endDrag);
  });
</script>
