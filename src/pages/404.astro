---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BadtzMaru from '../components/ui/BadtzMaru.astro';
---

<BaseLayout title="404: Page Not Found | Ethan Villanueva" description="The page you are looking for does not exist.">
  <Header />
  <main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 min-h-[60vh] flex flex-col items-center justify-center text-center py-20">
    <div class="space-y-6 max-w-md">
      <div class="flex justify-center mb-4">
        <BadtzMaru size={72} />
      </div>
      
      <div class="space-y-2">
        <span class="text-xs font-mono uppercase tracking-widest text-(--color-accent) font-semibold">Error 404</span>
        <h1 class="text-3xl sm:text-4xl font-bold text-(--color-text-primary)" style="font-family: var(--font-heading);">
          Page Not Found
        </h1>
        <p class="text-sm sm:text-base text-(--color-text-secondary) leading-relaxed">
          Looks like this route doesn't exist or has moved. Badtz-Maru is looking around but found nothing here!
        </p>
      </div>

      <div class="pt-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-md bg-(--color-accent) text-white hover:bg-(--color-accent-hover) transition-all shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Portfolio
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
